rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Users Collection
    match /users/{userId} {
      // Authenticated users can read profiles (needed for UID checks, profile display, customer management)
      allow read: if isAuthenticated();
      // Users can create/update their own profile document
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Products Collection
    match /products/{productId} {
      allow read: if true; // Public catalog browsing
      allow write: if isAuthenticated();
    }

    // Categories Collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    // Payment Methods & Bank Accounts
    match /paymentMethods/{id} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /bankAccounts/{id} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Banners & Notices
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /notices/{noticeId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Site Settings (support info, exchange rate, general, notice)
    match /siteSettings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Media Assets
    match /mediaAssets/{mediaId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Audit Logs
    match /auditLogs/{logId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Notification Jobs Queue
    match /notificationJobs/{jobId} {
      allow read, write: if isAuthenticated();
    }
  }
}
